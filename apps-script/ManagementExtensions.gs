function ensureManagementSheets_() {
  ensureMgmtSheet_(MGMT_SHEETS.absences, ['ID','С','По','Учитель','Причина','Комментарий','Создано'], true);
  ensureMgmtSheet_(MGMT_SHEETS.journal, ['Дата','Урок','Класс','Предмет','Кабинет','Основной учитель','Заменяющий учитель','Тип','Опубликовано'], true);
  ensureMgmtSheet_(MGMT_SHEETS.drafts, ['Дата','Обновлено','Учителя JSON','Ученики JSON'], true);
  ensureMgmtSheet_(MGMT_SHEETS.seen, ['Дата','Учитель','Просмотрено','Ключ устройства'], true);
  ensureMgmtSheet_(MGMT_SHEETS.notices, ['ID','Опубликовано','Заголовок','Текст','Тип','Начало','Окончание','Картинка','Файлы JSON','Текст кнопки','Ссылка','Аудитория','Активно'], false);
  const settings = ensureMgmtSheet_(MGMT_SHEETS.settings, ['Ключ','Значение','Обновлено'], true);
  upsertSetting_(settings, 'appsScriptUrl', ScriptApp.getService().getUrl() || '');
  return true;
}
function ensureMgmtSheet_(name, headers, hidden) { const ss=getSpreadsheet_(); let sh=ss.getSheetByName(name); if(!sh){sh=ss.insertSheet(name);sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);if(hidden)sh.hideSheet();} return sh; }
