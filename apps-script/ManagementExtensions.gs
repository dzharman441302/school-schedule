function getAdminDraft(token,dateIso){assertSession_(token);validateIsoDate_(dateIso);ensureManagementSheets_();const vals=getSpreadsheet_().getSheetByName(MGMT_SHEETS.drafts).getDataRange().getValues(),row=vals.slice(1).find(r=>normalizeDate_(r[0])===dateIso);if(!row)return null;return{date:dateIso,savedAt:row[1] instanceof Date?Utilities.formatDate(row[1],CONFIG.timeZone,'dd.MM.yyyy HH:mm:ss'):String(row[1]||''),teacherEdits:safeJsonParse_(row[2],[]),studentChanges:safeJsonParse_(row[3],[])};}
function listAdminDrafts(token){assertSession_(token);ensureManagementSheets_();const vals=getSpreadsheet_().getSheetByName(MGMT_SHEETS.drafts).getDataRange().getValues();return vals.slice(1).filter(r=>r.some(Boolean)).map(r=>({date:normalizeDate_(r[0]),savedAt:r[1] instanceof Date?Utilities.formatDate(r[1],CONFIG.timeZone,'dd.MM.yyyy HH:mm:ss'):String(r[1]||''),teacherCount:safeJsonParse_(r[2],[]).length,studentCount:safeJsonParse_(r[3],[]).length})).sort((a,b)=>a.date.localeCompare(b.date));}
