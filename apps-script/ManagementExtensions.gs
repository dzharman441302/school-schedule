function publishAdminDayManaged(token,dateIso,teacherEdits,studentChanges){assertSession_(token);const r=publishPayloadCore_(dateIso,teacherEdits,studentChanges,'Сейчас');recordReplacementJournal_(dateIso,teacherEdits);try{deleteAdminDraft(token,dateIso);}catch(_){}try{notifyMaxChanges_(dateIso,r.summary||{});}catch(_){}return r;}
function recordReplacementJournal_(dateIso,edits){ensureManagementSheets_();const built=buildEffectiveGrid_(dateIso,prepareTeacherEdits_(dateIso,edits||[])),baseByClass={};built.base.cells.forEach(c=>{if(c.className)baseByClass[c.className+'|'+c.lesson]=c;});const sh=getSpreadsheet_().getSheetByName(MGMT_SHEETS.journal),existing=sh.getDataRange().getValues(),preserved=existing.slice(1).filter(r=>normalizeDate_(r[0])!==dateIso),rows=[];built.effective.forEach(c=>{if(!c.className||!['changed','added','room'].includes(c.status))return;const original=baseByClass[c.className+'|'+c.lesson],originalTeacher=original?original.teacher:'';if(c.status==='room'&&originalTeacher===c.teacher)return;if(originalTeacher===c.teacher&&c.status!=='added')return;rows.push([formatRuDate_(dateIso),c.lesson,c.className,c.subject,c.room,originalTeacher,c.teacher,c.status,new Date()]);});rewriteBody_(sh,9,preserved.concat(rows));}
function getReplacementJournal(token,fromIso,toIso){assertSession_(token);ensureManagementSheets_();const from=normalizeDate_(fromIso),to=normalizeDate_(toIso),vals=getSpreadsheet_().getSheetByName(MGMT_SHEETS.journal).getDataRange().getValues();return vals.slice(1).filter(r=>{const d=normalizeDate_(r[0]);return d&&(!from||d>=from)&&(!to||d<=to);}).map(r=>({date:normalizeDate_(r[0]),lesson:Number(r[1])||0,className:String(r[2]||''),subject:String(r[3]||''),room:String(r[4]||''),originalTeacher:String(r[5]||''),replacementTeacher:String(r[6]||''),type:String(r[7]||'')}));}
