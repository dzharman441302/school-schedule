function markTeacherViewedPublic_(dateIso,teacher,deviceKey){if(!dateIso||!teacher)return false;ensureManagementSheets_();const sh=getSpreadsheet_().getSheetByName(MGMT_SHEETS.seen),vals=sh.getDataRange().getValues();for(let i=1;i<vals.length;i++)if(normalizeDate_(vals[i][0])===dateIso&&String(vals[i][1]||'')===teacher&&String(vals[i][3]||'')===String(deviceKey||'')){sh.getRange(i+1,3).setValue(new Date());return true;}sh.appendRow([formatRuDate_(dateIso),teacher,new Date(),String(deviceKey||'')]);return true;}
function getTeacherSeenSummary(token,dateIso){assertSession_(token);ensureManagementSheets_();const vals=getSpreadsheet_().getSheetByName(MGMT_SHEETS.seen).getDataRange().getValues(),out={};vals.slice(1).filter(r=>normalizeDate_(r[0])===dateIso).forEach(r=>{const t=String(r[1]||''),at=r[2] instanceof Date?Utilities.formatDate(r[2],CONFIG.timeZone,'HH:mm:ss'):String(r[2]||'');if(t)out[t]=at;});return out;}

function listNoticesAdmin(token){assertSession_(token);ensureManagementSheets_();const vals=getSpreadsheet_().getSheetByName(MGMT_SHEETS.notices).getDataRange().getValues();return vals.slice(1).filter(r=>r.some(Boolean)).reverse().map(r=>noticeRowToObject_(r));}
function noticeRowToObject_(r){return{id:String(r[0]||''),publishedAt:r[1] instanceof Date?Utilities.formatDate(r[1],CONFIG.timeZone,'dd.MM.yyyy HH:mm:ss'):String(r[1]||''),title:String(r[2]||''),text:String(r[3]||''),level:String(r[4]||'info'),start:normalizeDate_(r[5]),end:normalizeDate_(r[6]),image:String(r[7]||''),files:safeJsonParse_(r[8],[]),buttonText:String(r[9]||''),url:String(r[10]||''),audience:String(r[11]||'all'),active:String(r[12]||'').toLowerCase()!=='false'};}
function saveNotice(token,item){assertSession_(token);ensureManagementSheets_();const title=String(item&&item.title||'').trim(),text=String(item&&item.text||'').trim();if(!title&&!text)throw new Error('Заполните заголовок или текст');const id=String(item&&item.id||'')||Utilities.getUuid(),start=normalizeDate_(item&&item.start)||isoToday_(),end=normalizeDate_(item&&item.end)||start,row=[id,new Date(),title,text,String(item.level||'info'),formatRuDate_(start),formatRuDate_(end),String(item.image||''),JSON.stringify(item.files||[]),String(item.buttonText||''),String(item.url||''),String(item.audience||'all'),item.active===false?'false':'true'],sh=getSpreadsheet_().getSheetByName(MGMT_SHEETS.notices),vals=sh.getDataRange().getValues();for(let i=1;i<vals.length;i++)if(String(vals[i][0]||'')===id){sh.getRange(i+1,1,1,13).setValues([row]);maybeSendNoticeToMax_(item);return{id:id};}sh.appendRow(row);maybeSendNoticeToMax_(item);return{id:id};}
function deleteNotice(token,id){assertSession_(token);ensureManagementSheets_();const sh=getSpreadsheet_().getSheetByName(MGMT_SHEETS.notices),vals=sh.getDataRange().getValues();for(let i=1;i<vals.length;i++)if(String(vals[i][0]||'')===String(id||'')){sh.deleteRow(i+1);return true;}return false;}
function uploadNoticeFile(token,name,mimeType,base64Data){assertSession_(token);if(!base64Data)throw new Error('Файл пуст');const folder=getNoticeFolder_(),bytes=Utilities.base64Decode(String(base64Data).replace(/^data:[^,]+,/,'')),blob=Utilities.newBlob(bytes,String(mimeType||'application/octet-stream'),String(name||'file')),file=folder.createFile(blob);try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}catch(_){}return{id:file.getId(),name:file.getName(),mimeType:file.getMimeType(),viewUrl:'https://drive.google.com/file/d/'+file.getId()+'/view',directUrl:'https://drive.google.com/uc?export=view&id='+file.getId()};}
function getNoticeFolder_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('NOTICE_FOLDER_ID');if(id){try{return DriveApp.getFolderById(id);}catch(_){}}const f=DriveApp.createFolder('СОШ20 — файлы оповещений');p.setProperty('NOTICE_FOLDER_ID',f.getId());return f;}

