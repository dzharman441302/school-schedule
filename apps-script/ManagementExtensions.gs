function sendMaxTest(token){assertSession_(token);return sendMaxMessage_('Тестовое сообщение от системы расписания МОУ СОШ №20. Подключение MAX работает.');}
function sendMaxMessage_(text,userId){const p=PropertiesService.getScriptProperties(),bot=p.getProperty('MAX_BOT_TOKEN'),chat=p.getProperty('MAX_CHAT_ID');if(!bot)throw new Error('Не задан MAX_BOT_TOKEN');const target=userId?('user_id='+encodeURIComponent(userId)):('chat_id='+encodeURIComponent(chat));if(!userId&&!chat)throw new Error('Не задан MAX_CHAT_ID');const r=UrlFetchApp.fetch('https://platform-api2.max.ru/messages?'+target,{method:'post',contentType:'application/json',headers:{Authorization:bot},payload:JSON.stringify({text:String(text||'')}),muteHttpExceptions:true}),code=r.getResponseCode();if(code<200||code>=300)throw new Error('MAX API '+code+': '+r.getContentText().slice(0,300));return{ok:true,code:code};}
