name = "school20-max-bot"
main = "src/index.js"
compatibility_date = "2026-09-10"
workers_dev = true

[vars]
SCHOOL_SITE_URL = "https://sosh20tver.ru"
SPREADSHEET_ID = "1Va5atMLtrqb9JEXE7d9eytoTUFgN-lwT0xlYOevm4S4"
APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwLKHUH2tnJ845I5uQ8r1_PAe1svBx462EUcwpz7ex7P93wHhX0WM2RkPpPnlrIlvsglQ/exec"
TIME_ZONE = "Europe/Moscow"

[[d1_databases]]
binding = "DB"
database_name = "school20-max"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[triggers]
crons = ["* * * * *"]

# Секреты добавляются ТОЛЬКО через Cloudflare Secrets / wrangler secret put:
# BOT_TOKEN
# WEBHOOK_SECRET
# SHEETS_API_KEY
